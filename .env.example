# ---- MongoDB ----
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/al-fateh-leathers

# ---- Auth (admin sessions) ----
# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret
# Cookie is set to this many seconds (default 7 days)
SESSION_MAX_AGE=604800

# ---- Store settings ----
STORE_NAME="Al Fateh Leathers"
STORE_CURRENCY=EUR

# ---- Bank account shown to customers at checkout (also editable from Admin > Settings) ----
BANK_ACCOUNT_TITLE="Al Fateh Leathers"
BANK_NAME="Bank Name Here"
BANK_ACCOUNT_NUMBER="0000-0000-0000"
BANK_IBAN="PKxxXXXXXXXXXXXXXXXXXXXXXX"
BANK_SWIFT="XXXXXXXX"
OWNER_WHATSAPP="+92xxxxxxxxxx"
OWNER_EMAIL="owner@alfatehleathers.com"

# ---- SMTP (order confirmation + status emails) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Al Fateh Leathers <orders@alfatehleathers.com>"
# Where a copy of every new-order notification also gets sent
ADMIN_NOTIFY_EMAIL=owner@alfatehleathers.com

# ---- Cloudflare R2 (S3-compatible object storage for product images) ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=al-fateh-leathers
# The endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Public bucket URL - either the free r2.dev URL or your own custom domain connected in Cloudflare
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ---- First admin seed (used only by `npm run seed:admin`) ----
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_EMAIL=owner@alfatehleathers.com
SEED_ADMIN_PASSWORD=change-me-now
